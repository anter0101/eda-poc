{
  "name": "eda-poc",
  "version": "0.0.1",
  "private": true,
  "description": "Event-driven architecture POC (pnpm + Turbo + NestJS)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,mjs,json,md,yml,yaml}\"",
    "infra:up": "docker compose --env-file .env.development up -d",
    "infra:down": "docker compose --env-file .env.development down",
    "infra:logs": "docker compose --env-file .env.development logs -f",
    "ports:kill": "node scripts/kill-ports.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "turbo": "^2.5.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
